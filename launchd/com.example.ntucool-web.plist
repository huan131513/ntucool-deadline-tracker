<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.ntucool-web</string>

    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/ntucool-deadline-tracker/.venv/bin/python3</string>
        <string>/ABSOLUTE/PATH/TO/ntucool-deadline-tracker/app.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/ntucool-deadline-tracker</string>

    <!-- Persistent service, not a scheduled job: start now, and restart it
         automatically if it ever crashes or you log out/in. This is what
         makes the hourly /api/notify curl (see the other plist) reliable. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/ntucool-deadline-tracker/web.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/ntucool-deadline-tracker/web.log</string>
</dict>
</plist>
